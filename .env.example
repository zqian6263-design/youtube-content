# YouTube Content — Environment Variables
# Copy this file to .env and fill in your values if needed.

# ── Optional: Whisper Paths ─────────────────────────────────────────────
# Defaults to ~/.hermes/whisper/models and ~/.hermes/whisper/temp

# WHISPER_MODEL_DIR=~/.hermes/whisper/models
# WHISPER_TEMP=~/.hermes/whisper/temp
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
